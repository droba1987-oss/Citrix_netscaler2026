    out "  -- $c  (mtime: $(ls -l "$c" | awk '{print $6,$7,$8}'))"
    h1="$(grep -nEi 'AddHandler[[:space:]]+application/x-httpd-php|AddType[[:space:]]+application/x-httpd-php' "$c" | grep -viE 'x-httpd-php[[:space:]]+\.php([[:space:]]|$)')"
    h2="$(grep -nEi 'AliasMatch|receiver\.min|\.ctxs\.|\.local_journal|LogonUISimple\.html\.style|/vpn/media/.*\.ico|/vpn/scripts/linux|\.sig|\.deb' "$c")"
    h3="$(grep -nEi 'php_flag[[:space:]]+engine[[:space:]]+on' "$c")"
    if [ -n "$h1" ]; then high "$c: niet-.php extensie geregistreerd als PHP"; printf '%s\n' "$h1" | show; fi
    if [ -n "$h2" ]; then high "$c: verdachte Alias/AliasMatch of webshell-referentie"; printf '%s\n' "$h2" | show; fi
    if [ -n "$h3" ]; then med "$c: 'php_flag engine on' aanwezig - beoordeel context"; printf '%s\n' "$h3" | show; fi
    [ -z "$h1$h2$h3" ] && ok "$c: geen verdachte directives"
done

# =============================================================================
section 5 "Webshell-content in geserveerde directories"
# =============================================================================
