    VER="$(sed -n 's/^kernel="\/ns-\([0-9]*\.[0-9]*-[0-9]*\.[0-9]*\).*/\1/p' /flash/boot/loader.conf | head -1)"
fi
[ -z "$VER" ] && VER="$(ls /flash/ns-*.gz 2>/dev/null | sed -n 's/.*ns-\([0-9]*\.[0-9]*-[0-9]*\.[0-9]*\).*/\1/p' | sort | tail -1)"
if [ -n "$VER" ]; then
    REL="${VER%%-*}"; BLD="${VER#*-}"
    out "  Gedetecteerde versie: $VER"
    case "$REL" in
        14.1) if build_lt "$BLD" "73.37"; then high "Versie $VER is KWETSBAAR (fix: 14.1-73.37 of hoger)"; else ok "Versie $VER bevat de fix (let op: FIPS-builds apart controleren)"; fi ;;
        13.1) if build_lt "$BLD" "64.23"; then high "Versie $VER is KWETSBAAR (fix: 13.1-64.23; bij 'show ns variable' output -> 13.1-64.24)"; else ok "Versie $VER bevat de fix (13.1-FIPS/NDcPP: fix 13.1-37.279)"; fi ;;
        *)    high "Release $REL is EOL/onbekend in CTX697096 - behandel als kwetsbaar zonder fix" ;;
