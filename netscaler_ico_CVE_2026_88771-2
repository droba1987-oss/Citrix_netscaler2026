# ----------------------------------------------------------------------------- 
# Hulpfuncties
# -----------------------------------------------------------------------------
out()     { printf '%s\n' "$*" | tee -a "$REPORT"; }
section() { out ""; out "=================================================================="; out "[$1] $2"; out "=================================================================="; }
high()    { HIGH=$((HIGH+1)); out "  [HIGH]   $*"; }
med()     { MED=$((MED+1));   out "  [MEDIUM] $*"; }
info()    { INFO=$((INFO+1)); out "  [INFO]   $*"; }
ok()      { out "  [OK]     $*"; }
show()    { head -n "$MAXLINES" | sed 's/^/           | /' | tee -a "$REPORT"; }

sha256_of() {
    if command -v sha256 >/dev/null 2>&1; then sha256 -q "$1" 2>/dev/null
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" 2>/dev/null | awk '{print $1}'
    else openssl dgst -sha256 "$1" 2>/dev/null | awk '{print $NF}'; fi
}

# Grep in (ook ge-gzipte) logbestanden. Gebruik: lgrep <ERE-patroon> <bestanden...>
lgrep() {
    local pat="$1"; shift
    local f
    for f in "$@"; do
        [ -f "$f" ] || continue
        case "$f" in
            *.gz) gzip -dc "$f" 2>/dev/null | grep -aEi -- "$pat" 2>/dev/null | sed "s|^|$(basename "$f"): |" ;;
            *)    grep -aEi -- "$pat" "$f" 2>/dev/null | sed "s|^|$(basename "$f"): |" ;;
        esac
    done
}

# Controleer een log-patroon en rapporteer met ernst
log_hunt() { # <severity> <omschrijving> <patroon> <bestanden...>
    local sev="$1" desc="$2" pat="$3"; shift 3
    local hits n
    hits="$(lgrep "$pat" "$@")"
    if [ -n "$hits" ]; then
        n="$(printf '%s\n' "$hits" | wc -l | tr -d ' ')"
        "$sev" "$desc ($n regels)"
        printf '%s\n' "$hits" | show
    else
        ok "$desc: geen treffers"
    fi
}

# Versievergelijking: build_lt "73.30" "73.37" -> 0 (true) als eerste kleiner is
build_lt() {
    local a1 a2 b1 b2
    a1="${1%%.*}"; a2="${1#*.}"; b1="${2%%.*}"; b2="${2#*.}"
    [ "$a1" -lt "$b1" ] && return 0
    [ "$a1" -eq "$b1" ] && [ "$a2" -lt "$b2" ] && return 0
    return 1
}

