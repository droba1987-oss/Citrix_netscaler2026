section 13 "Logs: webshell-gebruik en post-exploitatie"
# =============================================================================
log_hunt high "Requests naar bekende webshell-paden" \
    '/logon/LogonPoint/(custom/(\.ctxs|receiver\.min)|\.local_journal|xua\.html)|/logon/insight-new\.js|LogonUISimple\.html\.style\.min\.css|/vpn/scripts/linux/[^ ]*\.(deb|sig|php)|\.php\?0=|/vpn/theme/[^ ]*\.php' $HTTPACC $HTTPERR
log_hunt high "NetScaler-header/cookie C2 (NSC_TASS, HTTP_X_UX, nsgclient)" \
    'NSC_TASS|X-UX|nsgclient\.ico|nsginstaller' $HTTPACC $HTTPERR
# 404 met grote response op /vpn/media|scripts|theme (Mandiant)
for f in $HTTPACC; do
    [ -f "$f" ] || continue
    case "$f" in *.gz) CAT="gzip -dc" ;; *) CAT="cat" ;; esac
    BIG="$($CAT "$f" 2>/dev/null | grep -aE '/vpn/media/|/vpn/scripts/|/vpn/theme/' | awk '($9 ~ /^(200|404)$/) && ($10+0 > 5000)')"
    [ -n "$BIG" ] && { high "$(basename "$f"): /vpn/media|scripts|theme met 200/404 en >5KB response (WHIPSHOT-patroon)"; printf '%s\n' "$BIG" | show; }
done
log_hunt med "httperror: PHP-/parse-fouten of niet-standaard extensies (.deb/.sig/.ico)" \
    '(PHP (Parse|Fatal|Warning)|File does not exist).*\.(deb|sig|rpm|tgz|ico|css)' $HTTPERR
SIG="$(lgrep 'SIGHUP received' $HTTPERR | grep -vE ':00:0[0-9]')"
[ -n "$SIG" ] && { med "httpd 'SIGHUP received' buiten de normale hh:00:0x graceful restarts:"; printf '%s\n' "$SIG" | show; }
log_hunt high "Shell-history: herstart/permissie/download commando's" \
    'nsshutdown -R|httpd -k restart|chmod (u\+s|6555|4755)[[:space:]]+/bin/sh|b64decode|base64 -d|curl[[:space:]]+(-[a-zA-Z]+[[:space:]]+)*https?://[0-9]|wget[[:space:]]|/tmp/\.uxd|update_c[0-9]+\.pl|main\.py' $SHLOGS
log_hunt high "Verwijzing naar bekende payload-URL's/bestanden in logs" \
    'xd7h/x|update_c08937|update_result_3567cs|/lula|main\.py|customsnmpd' $ALLLOGS

# =============================================================================
section 14 "Logs: bekende IOC-IP's en domeinen"
# =============================================================================
IPHITS=0
while IFS='|' read -r ip d; do
    [ -z "$ip" ] && continue
    pat="$(printf '%s' "$ip" | sed 's/\./\\./g')"
    hits="$(lgrep "(^|[^0-9])${pat}([^0-9]|$)" $ALLLOGS)"
    if [ -n "$hits" ]; then
        IPHITS=$((IPHITS+1))
        n="$(printf '%s\n' "$hits" | wc -l | tr -d ' ')"
        high "IOC-IP $ip ($d): $n regels"
        printf '%s\n' "$hits" | head -n 10 | sed 's/^/           | /' | tee -a "$REPORT"
    fi
done <<< "$IOC_IPS"
[ "$IPHITS" -eq 0 ] && ok "Geen van de $(printf '%s\n' "$IOC_IPS" | grep -c '|') IOC-IP's in lokale logs"
log_hunt high "Domein-IOC $IOC_DOMAINS" 'httpworkbench\.com' $ALLLOGS

# =============================================================================
section 15 "Log-integriteit (anti-forensics)"
# =============================================================================
for f in /var/log/ns.log /var/log/httpaccess.log /var/log/messages /var/log/sh.log; do
    [ -f "$f" ] || continue
    sz="$(wc -c < "$f" | tr -d ' ')"
    first="$(head -1 "$f" 2>/dev/null | cut -c1-60)"
    out "  $f: ${sz} bytes, eerste regel: $first"
    [ "$sz" -eq 0 ] && med "$f is leeg - mogelijk gewist"
done
OLDEST="$(ls -tr /var/log/ns.log* 2>/dev/null | head -1)"
info "Oudste ns.log: ${OLDEST:-n.v.t.} - als logs al geroteerd zijn sinds begin september, hunt in de SIEM (syslog-forwarding)"

# =============================================================================
section 16 "SAMENVATTING"
# =============================================================================
out "  HIGH:   $HIGH"
out "  MEDIUM: $MED"
out "  INFO:   $INFO"
out ""
if [ "$HIGH" -gt 0 ]; then
    out "  OORDEEL: MOGELIJK GECOMPROMITTEERD."
    out "  -> Isoleer de appliance, stop HA-sync, bewaar memory/disk/logs, start incident response."
    out "  -> Na patch: roteer ALLE credentials (nsroot, LDAP-bind, RADIUS, SSH-keys, TLS-keys),"
    out "     beeindig sessies (kill aaa/icaconnection), controleer StoreFront/DDC/AD op laterale beweging."
elif [ "$MED" -gt 0 ]; then
    out "  OORDEEL: VERDACHT - handmatige analyse van de [MEDIUM]-bevindingen vereist."
else
    out "  OORDEEL: geen bekende IOC's gevonden. Dit sluit compromittering NIET uit"
    out "  (unieke webshells per slachtoffer, logrotatie, anti-forensics). Hunt ook in SIEM/firewall."
fi
out ""
out "Rapport opgeslagen in: $REPORT"
exit "$HIGH"
