if [ -n "$EXISTING_WEB" ]; then
    # a) PHP-code in bestanden ZONDER .php extensie (masquerading: .css/.ico/.sig/.deb/.js/.html/dotfiles)
    A="$(grep -rlaE '<\?php|passthru\(|shell_exec\(' $EXISTING_WEB 2>/dev/null | grep -vE '\.(php|phtml|inc)$')"
    if [ -n "$A" ]; then high "PHP-code in bestanden zonder .php-extensie:"; printf '%s\n' "$A" | while read -r f; do ls -la "$f"; done | show; else ok "Geen PHP in niet-.php bestanden"; fi

    # b) Typische webshell-sinks gecombineerd met NetScaler-cookies/headers
    B="$(grep -rlaE 'NSC_TASS|HTTP_NSC_LDAP|HTTP_NSC_CLIENTTYPE|HTTP_X_UX|CsrfToken.*passthru|<FATO>|eval\(base64_decode|passthru\(urldecode|shell_exec\(base64_decode' $EXISTING_WEB /var/tmp /tmp 2>/dev/null | grep -v "$REPORT" | grep -v 'netscaler_ioc_check')"
